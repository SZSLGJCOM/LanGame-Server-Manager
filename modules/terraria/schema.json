{
  "type": "object",
  "title": "Terraria Dedicated Server",
  "properties": {
    "world_name": {
      "type": "string",
      "title": "New World Name",
      "description": "Name assigned when automatically creating a world. Loading an existing world keeps its saved name.",
      "default": "LanGame World",
      "x-lsgm-default-source": "instance_name",
      "x-lsgm-section": "room",
      "x-lsgm-order": 0,
      "x-lsgm-source": "serverconfig",
      "x-lsgm-source-key": "worldname",
      "x-lsgm-source-surface": "config_file"
    },
    "world_file": {
      "type": "string",
      "title": "World Save File",
      "description": "File name inside this instance's managed saves folder. Use a .wld file name only, not a full path.",
      "default": "world.wld",
      "pattern": "^[^\\\\\\/]+\\.wld$",
      "x-lsgm-section": "room",
      "x-lsgm-order": 10,
      "x-lsgm-source": "serverconfig",
      "x-lsgm-source-key": "world",
      "x-lsgm-source-surface": "config_file"
    },
    "motd": {
      "type": "string",
      "title": "Message of the Day",
      "description": "Shown to players when they join the server.",
      "default": "Welcome to the server!",
      "x-lsgm-section": "room",
      "x-lsgm-order": 30,
      "x-lsgm-source": "serverconfig",
      "x-lsgm-source-key": "motd",
      "x-lsgm-source-surface": "config_file"
    },
    "max_players": {
      "type": "integer",
      "title": "Max Players",
      "description": "Maximum number of connected players. Terraria accepts values from 1 to 255.",
      "default": 8,
      "minimum": 1,
      "maximum": 255,
      "x-lsgm-section": "room",
      "x-lsgm-order": 40,
      "x-lsgm-source": "serverconfig",
      "x-lsgm-source-key": "maxplayers",
      "x-lsgm-source-surface": "config_file"
    },
    "world_size": {
      "type": "integer",
      "title": "World Size",
      "description": "Only used when the managed world file does not exist yet and Terraria has to generate one.",
      "default": 2,
      "enum": [
        1,
        2,
        3
      ],
      "enum_labels": [
        "Small",
        "Medium",
        "Large"
      ],
      "x-lsgm-section": "world",
      "x-lsgm-order": 0,
      "x-lsgm-source": "serverconfig",
      "x-lsgm-source-key": "autocreate",
      "x-lsgm-source-surface": "config_file"
    },
    "difficulty": {
      "type": "integer",
      "title": "World Difficulty",
