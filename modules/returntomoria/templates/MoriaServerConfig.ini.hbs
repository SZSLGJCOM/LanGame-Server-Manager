[Main]
OptionalPassword={{settings.server_password}}

[World]
Name="{{settings.server_name}}"
OptionalWorldFilename="{{settings.world_file_name}}"

[World.Create]
Type={{settings.game_mode}}
Seed={{settings.world_seed}}
Difficulty.Preset={{settings.difficulty_preset}}
Difficulty.Custom.CombatDifficulty={{settings.combat_difficulty}}
Difficulty.Custom.EnemyAggression={{settings.enemy_aggression}}
Difficulty.Custom.SurvivalDifficulty={{settings.survival_difficulty}}
Difficulty.Custom.MiningDrops={{settings.mining_drops}}
Difficulty.Custom.WorldDrops={{settings.world_drops}}
Difficulty.Custom.HordeFrequency={{settings.horde_frequency}}
Difficulty.Custom.SiegeFrequency={{settings.siege_frequency}}
Difficulty.Custom.PatrolFrequency={{settings.patrol_frequency}}
OptionalDLC.Array="{{settings.optional_dlc_array}}"
UpgradeOptionalDLC.Array="{{settings.upgrade_optional_dlc_array}}"

[Host]
ListenAddress={{instance.bind_ip}}
ListenPort={{ports.game.port}}
AdvertiseAddress={{settings.advertise_address}}
AdvertisePort={{settings.advertise_port}}
InitialConnectionRetryTime={{settings.initial_connection_retry_seconds}}
AfterDisconnectionRetryTime={{settings.after_disconnection_retry_seconds}}

[Console]
Enabled={{settings.console_enabled}}

[Performance]
ServerFPS={{settings.server_fps}}
LoadedAreaLimit={{settings.loaded_area_limit}}
