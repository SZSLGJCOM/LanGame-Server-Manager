LangString installingWebview2 ${LANG_ENGLISH} "Preparing the WebView2 runtime..."
LangString newerVersionInstalled ${LANG_ENGLISH} "A later version of ${PRODUCTNAME} is installed. Installing an earlier version may not support your current data. Review the options before continuing."
LangString older ${LANG_ENGLISH} "previous"
