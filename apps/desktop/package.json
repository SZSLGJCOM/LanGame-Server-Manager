{
  "name": "langame-desktop-ui",
  "private": true,
  "version": "0.1.5",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27",
    "npm": ">=12.2.0 <13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.10.0 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0 <13",
      "onFail": "error"
    }
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43170 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "python -B ../../scripts/verify_project.py --component frontend-tests --tier quick",
    "test:browser": "python -B ../../scripts/verify_project.py --component frontend-browser",
    "test:full": "python -B ../../scripts/verify_project.py --component frontend-tests --tier full",
    "desktop": "cargo run --manifest-path src-tauri/Cargo.toml --bin langame-desktop",
    "smoke:ai-secret": "cargo test --manifest-path src-tauri/Cargo.toml assistant::tests::secret_roundtrip_file_backend_smoke -- --exact --nocapture",
    "audit:i18n": "node scripts/audit_i18n_surface.cjs",
    "verify:i18n": "node scripts/verify_i18n_catalogs.cjs",
    "verify:configuration-workspace": "node --test tests/ark-settings-benchmark.test.cjs tests/configuration-field.test.cjs tests/configuration-module-acceptance.test.cjs tests/configuration-native-mod-parameters.test.cjs tests/configuration-presentation.test.cjs tests/configuration-section-navigation.test.cjs tests/configuration-specialized-renderers.test.cjs tests/configuration-workspace.test.cjs tests/configuration-workspace-model.test.cjs tests/instance-network-settings.test.cjs tests/instance-settings-save-queue.test.cjs tests/maintenance-save-policy.test.cjs tests/maintenance-backup-policy.test.cjs tests/maintenance-autostart.test.cjs tests/save-settings-refresh.test.cjs",
    "verify:configuration-regressions": "node --test tests/minecraft-instance-detail-tabs.test.cjs tests/minecraft-returntomoria-formal-config.test.cjs tests/mod-settings-patch.test.cjs tests/settings-page-routing.test.cjs tests/survival-module-intake.test.cjs",
    "verify:dedicated-settings": "python -B ../../scripts/audit_dedicated_settings_pages.py --strict",
    "verify:config-provenance": "python -B ../../scripts/verify_game_config_provenance.py --check",
    "verify:game-knowledge": "python -B ../../scripts/verify_game_knowledge.py --check",
    "verify:module-settings": "python -B ../../scripts/verify_module_setting_coverage.py",
    "verify:config-acceptance": "python -B ../../scripts/verify_game_config_acceptance.py --require-all --check",
    "verify:library-media": "python -B ../../scripts/verify_library_media.py",
    "verify:no-tracked-secrets": "python -B ../../scripts/verify_no_tracked_secrets.py",
    "verify:open-source-boundary": "python -B ../../scripts/verify_open_source_boundary.py",
    "verify:open-source-history": "python -B ../../scripts/verify_open_source_history.py",
    "verify": "python -B ../../scripts/verify_project.py --component frontend --tier quick",
    "verify:release": "python -B ../../scripts/verify_project.py --component frontend --tier full",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@tauri-apps/api": "^2.12.3",
    "hls.js": "^1.7.3",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
